import random

answer = random.randint(1, 50)

while True:
    x = int(input("what is your number?"))

    if not (50<x<0):
        print("wrong number")
        continue

    if answer > x:
        print("up")
    elif answer < x:
        print("down")
    else:
        print("correct")
        break


